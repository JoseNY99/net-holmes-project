# ==============================================================================
# NET HOLMES — BRAND DEFENSE & OSINT PLATFORM
# ARCHIVO DE VARIABLES DE ENTORNO DE EJEMPLO (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS (PostgreSQL)
# Formato: postgresql://<usuario>:<password>@<host>:<puerto>/<nombre_db>
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://brand_user:TU_PASSWORD_SEGURO@127.0.0.1:5432/brand_checker_db

# ------------------------------------------------------------------------------
# 2. SEGURIDAD Y TOKENS JWT
# ------------------------------------------------------------------------------
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SECRETA_JWT_SUPER_SEGURA_ALEATORIA
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# 3. APIS DE ESCANEO OSINT E INTELIGENCIA ARTIFICIAL
# ------------------------------------------------------------------------------
# Google Serper API (https://serper.dev/) — Búsquedas OSINT web y redes sociales
SERPER_API_KEY=tu_serper_api_key_aqui

# Cerebras Cloud SDK (https://cerebras.ai/) — LLM Honeypot y extracción NLP
CEREBRAS_API_KEY=tu_cerebras_api_key_aqui

# Apify Cloud (https://apify.com/) — Opcional para escaneo profundo en la nube
APIFY_API_TOKEN=tu_apify_token_aqui

# RapidAPI (https://rapidapi.com/) — Opcional motor alternativo
RAPIDAPI_KEY=tu_rapidapi_key_aqui

# ------------------------------------------------------------------------------
# 4. MERCADO LIBRE DEVELOPERS API (developers.mercadolibre.com.ar)
# ------------------------------------------------------------------------------
MERCADOLIBRE_APP_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 5. WHATSAPP CLOUD API (Meta for Developers - Honeypot Integration)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ------------------------------------------------------------------------------
# 6. CONFIGURACIÓN DEL CRON & ZONA HORARIA
# ------------------------------------------------------------------------------
CRON_ENABLED=true
CRON_HOUR=2
CRON_MINUTE=0
TIMEZONE=America/Argentina/Buenos_Aires
